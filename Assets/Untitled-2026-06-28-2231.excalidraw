    {
      "id": "ClhhmMLb7PzC4ic97eFod",
      "type": "text",
      "x": -188.11666870117188,
      "y": 672.40625,
      "width": 600.7333374023438,
      "height": 350,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1586379454,
      "version": 335,
      "versionNonce": 1330151010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782668450149,
      "link": null,
      "locked": false,
      "text": "WE know we want speed for live dashboard but we are\nalready worknig on data that is published after market close\nso for following reasons:\n\n1. Memory Management: Python is notoriously hungry for\nRAM. If you try to hold 20 million rows in a single Pandas\nDataFrame and push it over a database connection, your\nscript might crash with an \"Out of Memory\" error. Saving to\nParquet keeps the memory footprint low.\n\n2. Audit Trail / Replayability: If your dashboard breaks, you\nstill have the raw Parquet files saved securely in S3. You can\neasily clear ClickHouse and rebuild the dashboard from the\nfiles.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WE know we want speed for live dashboard but we are already worknig on data that is published after market close so for following reasons:\n\n1. Memory Management: Python is notoriously hungry for RAM. If you try to hold 20 million rows in a single Pandas DataFrame and push it over a database connection, your script might crash with an \"Out of Memory\" error. Saving to Parquet keeps the memory footprint low.\n\n2. Audit Trail / Replayability: If your dashboard breaks, you still have the raw Parquet files saved securely in S3. You can easily clear ClickHouse and rebuild the dashboard from the files.",
      "autoResize": false,
      "lineHeight": 1.25
    },
